#!/bin/sh
# 提交前拦截：台账格式 / 规模数字 不合规就拒绝提交。
# 只跑结构性校验（秒级），完整的 npm run check 仍然在手动或 CI 里跑。
# 启用方式：git config core.hooksPath scripts/hooks

fail=0

echo "[pre-commit] 台账校验…"
node scripts/ledger.mjs || fail=1

echo "[pre-commit] 规模数字校验…"
node scripts/stats.mjs --check || fail=1

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "[pre-commit] 拒绝提交。"
  echo "  台账格式坏了：多半是说明列里写了换行，把一行拆成了多行——合并成一行即可。"
  echo "  数字漂移了：跑 npm run stats 重新生成（不要手改生成物）。"
  echo "  想跳过（不推荐）：git commit --no-verify"
  exit 1
fi

echo "[pre-commit] 通过"
