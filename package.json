{
  "name": "psz-panel-v5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "设计助理新面板（Vue 3 + TypeScript + Vite，CEP 12）",
  "scripts": {
    "dev": "vite",
    "dev:cep": "node scripts/cep-dev.mjs && vite",
    "check": "node scripts/style-guard.mjs && node scripts/ledger.mjs",
    "ledger": "node scripts/ledger.mjs",
    "log:new": "node scripts/log.mjs new",
    "log:index": "node scripts/log.mjs index",
    "registry": "node scripts/registry.mjs fix && node scripts/registry.mjs gen",
    "style:fix": "node scripts/style-guard.mjs --fix",
    "style:baseline": "node scripts/style-guard.mjs --update",
    "build": "node scripts/style-guard.mjs && vue-tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "deploy": "npm run check && npm run build",
    "build:fast": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
