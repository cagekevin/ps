{
  "name": "psz-panel-v5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "设计助理新面板（Vue 3 + TypeScript + Vite，CEP 12）",
  "scripts": {
    "dev": "vite",
    "dev:cep": "node scripts/cep-dev.mjs && vite",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{ts,js,json}\"",
    "style:guard": "node scripts/style-guard.mjs",
    "boundary:pages": "node scripts/page-boundary.mjs",
    "spec:check": "node scripts/task-spec.mjs docs/规范/任务书模板.md",
    "template:guard": "node scripts/vue-template-guard.mjs",
    "check": "npm run style:guard && npm run template:guard && npm run boundary:pages && npm run spec:check && npm run ledger && npm run stats:check && npm run lint && npm run format:check",
    "jsx:dispatch": "node scripts/jsx-dispatch.mjs",
    "stats:check": "node scripts/stats.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "ledger": "node scripts/ledger.mjs",
    "log:new": "node scripts/log.mjs new",
    "log:index": "node scripts/log.mjs index",
    "interactions": "node scripts/interactions.mjs",
    "list": "node scripts/page-list.mjs",
    "new:page": "node scripts/new-page.mjs",
    "registry": "node scripts/registry.mjs fix && node scripts/registry.mjs gen",
    "spec": "node scripts/page-spec.mjs",
    "stats": "node scripts/stats.mjs gen",
    "style:fix": "node scripts/style-guard.mjs --fix",
    "style:baseline": "node scripts/style-guard.mjs --update",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.tests.json",
    "deploy": "npm run check && npm run typecheck && npm run build && npm run verify:dist",
    "render:check": "node scripts/render-check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  }
}
